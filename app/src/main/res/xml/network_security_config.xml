<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is off everywhere except loopback.

  Loopback is the exception because a self-hosted model (Ollama, LM Studio)
  and the preview pane's own dev server both live on 127.0.0.1, where TLS
  would add nothing: the traffic never leaves the handset.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
